# Chave de API da Groq (obrigatória)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_groq_aqui

# Chave de API da Mistral (opcional, caso queira usar Mistral em vez de Groq)
MISTRAL_API_KEY=sua_chave_mistral_aqui

# Token HuggingFace (opcional, para downloads de modelos de embeddings)
HF_TOKEN=seu_token_huggingface_aqui
